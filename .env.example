# Tu Token del bot de Telegram (obtenido en @BotFather)
# IMPORTANTE: Este token debe ser EXCLUSIVO para este proyecto. 
# No uses un bot que ya estés usando en otro programa (como notificaciones de Radarr o Home Assistant), 
# ya que Telegram bloqueará la conexión al detectar conflicto de lectura.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmNOPqrstUVWxyz

# URL de tu instancia de Overseerr
OVERSEERR_URL=http://tu-ip-o-dominio:5055

# API Key de Overseerr (Settings -> General -> API Key)
OVERSEERR_API_KEY=tu_api_key_aqui

# Mapeo de usuarios: { "ID_TELEGRAM": "ID_OVERSEERR" }
# ID_TELEGRAM: Puede ser el ID numérico de un usuario o el ID de un grupo de Telegram (ej. empiezan por -).
# ID_OVERSEERR: Debe ser el ID NUMERICO del usuario en Overseerr (ej. "1", "2"), NO su nombre de usuario.
# Ejemplo: si tu ID de Telegram es 111111 y tu ID numérico de Overseerr es 1
USER_MAPPING={"111111": "1"}
